<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6b83d63d-62f8-4493-a6ca-37eca77a29bd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Pins EF Core to the version Npgsql 10.0.3 targets. EFCore.NamingConventions 10.0.1 asks
         for 10.0.4, and without this the test project's assembly resolution picks the older one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive pin, same pattern as the Relational one above. Microsoft.AspNetCore.OpenApi
         10.0.10 still resolves Microsoft.OpenApi 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (high;
         patched in 2.7.5). The advisory is a parser DoS and this app only *generates* documents,
         so the practical exposure is nil — pinned anyway, because a permanent NU1903 on every
         build is how a real advisory later gets ignored. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.8.0" />
  </ItemGroup>

</Project>
