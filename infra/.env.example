POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
ASPNETCORE_ENVIRONMENT=

Sentry__Dsn=
Sentry__Environment=

# Read by backup.sh only — Compose ignores them (tech-06 §10.2). Both are required and neither has
# a default: a backup job that falls back to a guessed folder is one that reports success while
# writing where nobody looks. BACKUP_REMOTE_DIR must be a folder an already-running cloud client
# syncs, and §10.1 is what happens without it. Forward slashes; no quotes, even for paths with
# spaces — this file is not shell, and quotes would be read as part of the value.
BACKUP_LOCAL_DIR=
BACKUP_REMOTE_DIR=
