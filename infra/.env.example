# Copy to .env (gitignored) and fill in. Values are deliberately blank — a stale example value is
# worse than none, because it looks authoritative. T6 §2, §4.1.
#
# The API's connection string when run from the *host* (dotnet run, dotnet ef) does not come from
# here: it lives in user-secrets on the dev machine. See api/Traverser.Api/appsettings.Development.json.

# Postgres container. The password is generated once and only ever exists in .env and its backup (T6 §10.5).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# API container. Compose interpolates the POSTGRES_* values into this so the two cannot drift:
# Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
ConnectionStrings__Traverser=

# Sentry (T6 §9) — the only account/key in the stack. Free tier, no card.
Sentry__Dsn=
